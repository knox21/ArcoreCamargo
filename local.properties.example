## Copia este archivo a local.properties y ajusta las rutas.
## Android Studio lo genera solo si abres el proyecto con el SDK instalado.

sdk.dir=C:\\Users\\Admin\\AppData\\Local\\Android\\Sdk

## Clave de Google Cloud con la API "ARCore API" habilitada.
## Sin esta clave, el modo Geospatial (VPS) no localiza; el modo GPS offline sí funciona.
ARCORE_API_KEY=PEGA_AQUI_TU_CLAVE
